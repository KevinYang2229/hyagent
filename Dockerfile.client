# HyAgent — client 服務（Vite 靜態網站，用 nginx 提供）
# build context = repo 根目錄

# ---- build stage ----
# 基底映像走 Google 的 Docker Hub 快取（mirror.gcr.io），不直接拉 docker.io。
# Zeabur 的 build 節點是共用出口 IP，匿名拉取很容易撞上 Docker Hub 的速率限制而
# 整個 build 掛掉（429 Too Many Requests）。mirror.gcr.io 是透通快取，digest 與
# Docker Hub 上的同一個 tag 完全相同，換的只是拉取來源，不是映像本身。
FROM mirror.gcr.io/library/node:20-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY ui/package.json ./ui/
COPY server/package.json ./server/
COPY client/package.json ./client/
# --include=dev：Zeabur build 環境預設 NODE_ENV=production，會讓 npm 跳過 devDependencies
# （vite / tsc / @vitejs/plugin-react 等在 devDeps），強制裝進來才 build 得了
RUN npm ci --include=dev

COPY . .

# Vite 在 build 階段就把 VITE_* bake 進 JS bundle（不是 runtime 讀）。
# Zeabur 會把 client 服務的環境變數當成 build arg 傳進來。
ARG VITE_API_BASE
ENV VITE_API_BASE=$VITE_API_BASE
# 部署層預設租戶公開金鑰（pk_…）：單一 client 綁單一租戶時設定，非嵌入使用也吃到該租戶設定。
ARG VITE_TENANT_KEY
ENV VITE_TENANT_KEY=$VITE_TENANT_KEY
RUN npm run build -w client

# ---- serve stage ----
FROM mirror.gcr.io/library/nginx:alpine AS runtime
COPY client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 8080
