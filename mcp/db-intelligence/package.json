{
  "name": "@hyagent/db-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Database Intelligence MCP 服務：掃描客戶資料庫 Metadata、以結構化 Query Plan 在受控權限內查詢（PostgreSQL 優先）。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "catalog:sync": "tsx scripts/catalog-sync.ts",
    "catalog:review": "tsx scripts/catalog-review.ts",
    "demo-db": "docker compose -f infra/docker-compose.yml up -d",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hyagent/mcp-kit": "*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
