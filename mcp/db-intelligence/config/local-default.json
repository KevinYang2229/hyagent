        "dataset": "public.projects",
        "principals": {
          "roles": [
            "manager"
          ]
        },
        "columns": [
          "*"
        ]
      },
      {
        "id": "all-departments",
        "tenantId": "default",
        "dataSourceId": "ds_project_01",
        "dataset": "public.departments",
        "principals": {
          "roles": [
            "employee",
            "manager",
            "hr"
          ]
        },
        "columns": [
          "*"
        ]
      },
      {
        "id": "hr-salary-statistics",
        "tenantId": "default",
        "dataSourceId": "ds_project_01",
