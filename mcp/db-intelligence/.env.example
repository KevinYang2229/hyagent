# 本機開發：複製成 .env 後執行 npm run dev -w mcp/db-intelligence（.env 不進版控）
PORT=4300
# 須與 HyAgent 後台「MCP 服務」登記的 serverId 相同
MCP_SERVER_ID=db-intelligence
HYAGENT_JWKS_URL=http://localhost:3000/.well-known/hyagent-mcp-jwks.json
# 執行期設定（state.json）與 Catalog 的存放目錄；state.json 不存在時以 DBI_CONFIG 為種子
DBI_DATA_DIR=data
DBI_CONFIG=config/local-default.json
# 資料來源連線字串（變數名稱對應設定裡的 connectionEnv）；請用只有 SELECT 權限的帳號
DBI_DS_PROJECT_01_URL=postgres://hyagent_reader:reader_dev_only@localhost:54330/projects
# OA 組織開發資料庫（MariaDB）：npm run demo-db:oa
DBI_DS_OA_ORG_URL=mysql://hyagent_reader:reader_dev_only@localhost:54343/oa_organization_db
