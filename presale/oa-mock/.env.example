# 模擬 OA 系統（presale/oa-mock/server.mjs）設定；複製為 .env 後生效
PORT=4100

# 送出成功時回的狀態字串。改成 oa.schema.json 的 statusMap 沒列的值（如 UNKNOWN），
# 可驗證「未命中一律 fallback pending」這條隱含規則
MOCK_STATUS=accepted

# 設了就一律回這個 HTTP 狀態碼，用來驗證連接器的錯誤路徑（400=欄位錯、500=OA 掛了）
# MOCK_FAIL_STATUS=500

# 回應前延遲毫秒數；設 >15000 可驗證連接器的 15 秒逾時
# MOCK_DELAY_MS=16000

# 設了就要求 Authorization: Bearer <此值>，對應 server 端的 OA_API_KEY
# MOCK_REQUIRE_TOKEN=demo-oa-token
