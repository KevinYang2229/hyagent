# 模擬租戶後端設定（複製成 .env 後修改；server.mjs 會自動載入同目錄 .env）

# 此模擬網站的埠
PORT=4000

# HyAgent 來源（載入 widget.js 與聊天面板 iframe 的網域＝client 服務）
# 本機 dev：client dev server 在 5173，widget.js 的實體是 client/public/sdk/widget.js，
# 對外路徑即 /sdk/widget.js（規格 §7.2 定稿的單一可變路徑；舊的根目錄 /widget.js 明確回 404）。
# 填 server 的 3000 會拿到 404，widget 根本載不進來。
OA_ORIGIN=http://localhost:5173

# API（server）對外來源。前後端分開部署時必填，指向 server 網域（≠ OA_ORIGIN）。
# 本機 dev 就是分開的（client 5173 / server 3000），所以這裡要填。
# 例：OA_API_ORIGIN=https://hyagent-server.zeabur.app
# 只有同網域 / 有 dev proxy 時才留空（留空＝沿用 OA_ORIGIN）。
OA_API_ORIGIN=http://localhost:3000

# 租戶公開金鑰。**必填，且每台機器不一樣**，所以這裡不給預設值。
# server 只存金鑰的 sha256，pk 原文只在下列時機回傳一次，事後無法反查：
#   - 後台 http://localhost:5174 建租戶時
#   - 對既有租戶補發：POST /api/admin/tenants/{id}/keys  body {"type":"publishable"}
# 該租戶的 allowedOrigins 要含本 demo 的來源（預設 http://localhost:4000）。
TENANT_PK=

# Tenant ID：Assertion 的 iss，換發時的租戶依據（規格 §8.4 步驟 10）。建租戶時取得。
TENANT_ID=

# 簽發 Assertion 的私鑰（PKCS#8 PEM）。**絕不可離開貴方環境**（規格 §2.2）。
# 留空時 demo 會當場產一組並把公鑰印在 console，貼到後台即可；重啟會換一組。
# 正式環境請改放 KMS / Vault。
TENANT_PRIVATE_KEY=

# 模擬「對方系統目前登入的使用者」。sub 用工號、name 是顯示名稱，
# 兩者會直接成為 Assertion 的 sub / name（整合手冊 §4.3）。
DEMO_USER_ID=507
DEMO_USER_NAME=測試員

# 對方系統自家的組織欄位，會包成 Assertion 的 hyagent:profile 物件（規格 §4.2.3）。
# HyAgent 不解讀語意、原樣帶過；留空的欄位不會進 claims。
DEMO_COMPANY_NAME=凌網
DEMO_DEPT_NAME=財務部
DEMO_JOB_POST_NAME=協理
