# SDK 自訂 UI 測試網站設定（複製成 .env 後修改；server.mjs 會自動載入同目錄 .env）

# 此模擬網站的埠（4000 是 widge-tenant、4001 是 widge-public）
PORT=4200

# HyAgent API（server）來源。**這支和 widget 版相反，要填 3000，不是 5173**：
# 這裡不載 widget.js、不用 iframe，SDK 直接從本頁面「跨網域」打 API，
# 會經過 CORS 檢查，放行與否看的是租戶的 allowedOrigins（與 widget 在 iframe 內同源不同）。
OA_ORIGIN=http://localhost:3000

# 租戶公開金鑰。**必填，且每台機器不一樣**，所以這裡不給預設值。
# server 只存金鑰的 sha256，pk 原文只在下列時機回傳一次，事後無法反查：
#   - 後台 http://localhost:5174 建租戶時
#   - 對既有租戶補發：POST /api/admin/tenants/{id}/keys  body {"type":"publishable"}
# 該租戶的 allowedOrigins 必須包含本 demo 的來源（預設 http://localhost:4200）或 *。
TENANT_PK=

# Tenant ID：Assertion 的 iss，換發時的租戶依據，也決定 Origin 白名單查哪一個租戶。**必填**。
TENANT_ID=

# 簽發 Assertion 的私鑰（PKCS#8 PEM）。**絕不可離開貴方環境**（規格 §2.2）。
# 留空時 demo 會當場產一組並把公鑰印在 console，貼到後台即可；但重啟就換一組、得重貼。
# 想固定一把：node sdk/bin/keygen.mjs ES256 <輸出目錄>，私鑰整段（含 BEGIN/END 兩行）
# 用雙引號包起來填在這裡，公鑰貼到後台該租戶的「Assertion 公鑰」。正式環境請改放 KMS / Vault。
TENANT_PRIVATE_KEY=

# 模擬「對方系統的使用者目錄」：登入頁上二選一。sub 用工號、name 是顯示名稱，
# 兩者會直接成為 Assertion 的 sub / name（整合手冊 §4.3）。
DEMO_USER_ID=507
DEMO_USER_NAME=測試員

# 對方系統自家的組織欄位，會包成 Assertion 的 hyagent:profile（規格 §4.2.3）。
# HyAgent 採用 companyName / deptName / jobPostName 為公司／部門／職稱；留空的欄位不進 claims。
DEMO_COMPANY_NAME=Beta Cloud
DEMO_DEPT_NAME=財務部
DEMO_JOB_POST_NAME=協理

# 第二位。部門與職稱刻意跟第一位不同——換人登入後 console 印出的登入者整串都會變，
# 一眼就看得出 Assertion 有沒有重簽（整合手冊 §5.3）。
DEMO_USER2_ID=902
DEMO_USER2_NAME=王小明
DEMO_USER2_COMPANY_NAME=Beta Cloud
DEMO_USER2_DEPT_NAME=研發部
DEMO_USER2_JOB_POST_NAME=工程師
