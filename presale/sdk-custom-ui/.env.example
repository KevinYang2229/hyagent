# SDK 自訂 UI 測試網站設定（複製成 .env；server.mjs 會自動載入同目錄 .env）

PORT=4200
OA_ORIGIN=http://localhost:3000

# 租戶公開金鑰；注意：此租戶的 allowedOrigins 必須包含 http://localhost:4200（或 *）
# 因為 SDK 是從本頁面「跨網域」直接呼叫 OA，會經過 CORS 檢查（與 widget 在 iframe 內同源不同）
TENANT_PK=pk_3dc8a9721d103efb0972aac2c0ef79d237698f765178fc6a

# Tenant ID（Assertion 的 iss）與簽發私鑰；私鑰留空時啟動會當場產一組並印出公鑰
TENANT_ID=
TENANT_PRIVATE_KEY=

# 模擬「對方系統目前登入的使用者」。sub 用工號、name 是顯示名稱，
# 兩者會直接成為 Assertion 的 sub / name（整合手冊 §4.3）。
DEMO_USER_ID=507
DEMO_USER_NAME=測試員

# 對方系統自家的組織欄位，會包成 Assertion 的 hyagent:profile（規格 §4.2.3）。
# HyAgent 採用 companyName / deptName / jobPostName 為公司／部門／職稱；留空的欄位不進 claims。
DEMO_COMPANY_NAME=Beta Cloud
DEMO_DEPT_NAME=財務部
DEMO_JOB_POST_NAME=協理
