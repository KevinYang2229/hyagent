{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // server 子入口被 presale 的 .mjs 以 Node 原生型別剝離直接載入，relative import 必須帶
    // 副檔名才解析得到；本套件不做 build（exports 直接指向 .ts 原始碼），故開這個旗標無副作用。
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
