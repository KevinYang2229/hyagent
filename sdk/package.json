{
  "name": "@hyagent/sdk",
  "version": "1.2.0",
  "description": "HyAgent 整合 SDK（瀏覽器端）：headless REST 客戶端 + widget 事件/控制橋接。",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "bin": {
    "hyagent-keygen": "./bin/keygen.mjs"
  },
  "scripts": {
    "keygen": "node bin/keygen.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyagent/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
