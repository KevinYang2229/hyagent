# client：靜態網站 + /api 同源反向代理
#
# 這是 envsubst 模板，不是能直接用的 conf。nginx 官方映像的 entrypoint 會把
# /etc/nginx/templates/*.template 展開到 /etc/nginx/conf.d/。只有
# NGINX_ENVSUBST_FILTER 列出的變數會被替換，nginx 自己的 $uri / $host / $1 不受影響。
#
#   PORT          監聽埠。Cloud Run 會注入（預設 8080），其他平台沿用 Dockerfile 的預設值
#   API_UPSTREAM  後端 server 的 origin，例 https://hyagent-server-xxxx.asia-east1.run.app
#
# 為何要代理而不是讓前端直打後端：VITE_API_BASE 是 Vite 在 build 階段 bake 進 bundle 的，
# 換後端網址就得重 build 映像。走同源代理後前端一律用相對路徑（VITE_API_BASE 留空），
# 後端位置變成 runtime 環境變數，且瀏覽器不跨網域 → 不必再管 CORS。

# 從 API_UPSTREAM 取出主機名，供 Host 標頭與 TLS SNI 使用。
# map 只能以「變數」為來源，所以先把常數包成 $api_upstream 再取。
map $host $api_upstream {
    default "${API_UPSTREAM}";
}
map $api_upstream $api_host {
    "~^https?://([^/:]+)" $1;
    default                $api_upstream;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # proxy_pass 目標寫成變數時，nginx 改在「每次請求當下」解析網域，沒有 resolver 會直接 502。
    # 169.254.169.254 是 GCP 的 metadata DNS；8.8.8.8 當後備。
    # ipv6=off 不能省：容器沒有 IPv6 出口時，AAAA 查詢會拖慢甚至解析失敗。
    resolver 169.254.169.254 8.8.8.8 valid=30s ipv6=off;

    # 靜態資源帶長快取（檔名含 hash，可安全長期快取）
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # /sdk/widget.js 是第三方網站直接嵌入的入口檔（規格 §7.2 定稿的對外路徑），
    # 檔名固定、不帶 hash，改版後對方瀏覽器多久拿到新版必須可控。沒有 Cache-Control 時
    # 瀏覽器會改用「啟發式快取」（依 Last-Modified 的久遠程度自行推算，通常取距今時間的
    # 10%），檔案越久沒動就被快取越久且不重新驗證——實際造成過宿主頁跑舊版 widget、
    # 後台改了外觀卻沒反應。
    #
    # 規格要求 max-age ≤ 300：這條路徑是可變的，緊急修補靠「就地更新」推送，
    # 而 300 秒就是修補的傳播上限。這也是為什麼規格不強制 SRI——鎖住雜湊等於鎖住修補。
    location = /sdk/widget.js {
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }

    # 舊的根路徑：檔案已搬到 /sdk/widget.js，這裡不留別名也不轉址——規格 §7.2 要的是
    # 單一可變路徑。但必須明確回 404：不寫這條會掉進下面的 SPA fallback 拿到 index.html，
    # 宿主頁把 HTML 當 JS 執行只會噴一句 "Unexpected token '<'"，完全看不出是路徑改了。
    location = /widget.js {
        return 404;
    }

    # 後端 API
    location /api/ {
        # 目標帶變數時 nginx 不會自動接上原始路徑，必須自己補 $request_uri
        proxy_pass $api_upstream$request_uri;

        # Host 要送後端自己的網域：Cloud Run 靠 Host 決定路由到哪個服務，
        # 照原樣轉送 client 的 Host 會被判成未知服務而回 404。
        proxy_set_header Host $api_host;
        # 對 https 後端做 SNI，缺了同樣是 404
        proxy_ssl_server_name on;
        proxy_ssl_name        $api_host;

        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header X-Forwarded-Host   $host;

        # LLM 對話與報告產生（PDF）都可能跑數十秒，預設 60s 會中途斷線
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 前端的「AI 已連線」指示燈探的是 /api/healthz（走上面那條 /api/ 代理），不是這裡。
    # 原因：Cloud Run 的 GFE 會攔截根路徑「精確的 /healthz」自行回 404，請求連 nginx
    # 都到不了，這條規則在 Cloud Run 上等於不存在。留著是給 Zeabur / K8s 等
    # 以 /healthz 當探針、且會實際打到容器的平台用。
    location = /healthz {
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host  $api_host;
        proxy_ssl_server_name  on;
        proxy_ssl_name         $api_host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
