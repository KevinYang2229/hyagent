// hyagent 持久化層（DATA_BACKEND=db 時啟用；Supabase Postgres）。
//
// 第一階段只搬 tenant store：資料表是「記憶體 Map 的 write-through 落地」，
// service / store 介面不變（見 tenant.store.ts 檔頭說明）。
// 穩定欄位開實體 column（dashboard 可讀、可查詢），其餘選填設定收進 config jsonb，
// Tenant 型別加欄位時不需跟著改 DDL。
//
// DDL 以 SQL migration 管理（server/db/migrations/，經 Supabase 套用），
// 本檔僅作 client 型別來源；改 schema 時兩邊要同步。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SecurityClaim {
  key String @id
  createdAt DateTime @default(now()) @map("created_at")
  /// NULL＝永不過期（refresh 與送出防重）；非 NULL＝一次性紀錄，到期後由清理排程回收。
  /// Assertion 的 jti 走這條（規格 §8.5），值取該 Assertion 的 exp。
  expiresAt DateTime? @map("expires_at")

  @@index([expiresAt])
  @@map("security_claims")
}

model TenantRow {
  id        String      @id
  name      String
  /// Tenant 型別中除 id/name/createdAt 外的所有選填欄位（allowedOrigins、llmConfig…）
  config    Json        @default("{}")
  createdAt DateTime    @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  apiKeys   ApiKeyRow[]

  @@map("tenants")
}

/// HyAgent Session（規格 §7.1）。**與下方 SessionRow 是完全不同的東西**：
/// 那張 sessions 是「對話」session（formId / data），這張是身分 session。
/// 兩者語意無關，所以表名取 auth_sessions 而非沿用 sessions，避免在程式碼裡混淆。
///
/// 不存 sessionToken 原文（只存 sha256）、不存 sub 明文（存 HMAC + 可逆密文），
/// 理由見 src/lib/auth-session.store.ts 檔頭。
model AuthSessionRow {
  /// sha256(sessionToken)
  id        String   @id
  tenantId  String   @map("tenant_id")
  /// HMAC(tenantId, sub)，供依 sub 批次作廢的等值比對（§7.4）
  subHash   String   @map("sub_hash")
  /// 靜態加密後的 sub。業務層需要原文（對話歸屬、ACL），所以這欄位是承載身分的；
  /// 正式環境未設 DATA_ENCRYPTION_KEY 時會在建立 Session 當下就被拒絕。
  subEnc    String   @map("sub_enc")
  /// 建立此 Session 時驗證通過的公鑰（§2.6 依 kid 批次作廢）。
  /// 規格明文要求此欄位自第一版即納入 schema——事後補建涵蓋不到既有 Session。
  kid       String
  name      String?
  /// Assertion 的 hyagent:profile（§4.2.3）。租戶未建人員目錄時，/me 與部門授權由它補值。
  profile   Json?
  createdAt DateTime @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([tenantId, kid])
  @@index([tenantId, subHash])
  @@index([expiresAt])
  /// 後台 Session 列表：依租戶篩選、建立時間倒序分頁（上面幾個索引排序用不上）
  @@index([tenantId, createdAt])
  @@map("auth_sessions")
}

model SessionRow {
  id        String   @id
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  formId    String   @map("form_id")
  /// 整個 Session 物件（values / messages / status…）；single source，實體欄位僅供查詢
  data      Json
  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@map("sessions")
}

model SubmissionRow {
  tenantId    String   @map("tenant_id")
  oaRequestId String   @map("oa_request_id")
  formId      String   @map("form_id")
  formTitle   String   @map("form_title")
  userId      String   @map("user_id")
  submittedAt DateTime @map("submitted_at")

  @@id([tenantId, oaRequestId])
  @@index([tenantId, userId, submittedAt])
  @@map("submissions")
}

model AttachmentRow {
  id        String   @id
  sessionId String   @map("session_id")
  name      String
  mime      String
  size      Int
  /// 檔案二進位內容。表單附件單檔上限 10MB；量大時改接 S3/R2（attachment.store 為唯一接縫）
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at")

  // 不設 FK 到 sessions：insert 與 session upsert 分屬不同寫入佇列、順序無保證；
  // 孤兒列由 session 清理作業一併回收
  @@index([sessionId])
  @@map("attachments")
}

model TenantUsageRow {
  tenantId  String   @id @map("tenant_id")
  /// 整個 TenantUsage 聚合計數（counters + llmByModel buckets）
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_usage")
}

model AuditLogRow {
  id       BigInt   @id @default(autoincrement())
  tenantId String   @map("tenant_id")
  toolId   String   @map("tool_id")
  userId   String   @map("user_id")
  at       DateTime
  ok       Boolean
  summary  String
  error    String?

  @@index([tenantId, at])
  @@map("audit_logs")
}

model TenantFormRow {
  tenantId   String   @map("tenant_id")
  formId     String   @map("form_id")
  /// 六層 Definition 整包
  definition Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([tenantId, formId])
  @@map("tenant_forms")
}

model ScopePolicyRow {
  tenantId  String   @id @map("tenant_id")
  /// TenantPolicy（groups / accounts）
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scope_policies")
}

model WebhookRow {
  id        String   @id
  tenantId  String   @map("tenant_id")
  /// 整個 WebhookEndpoint（url / secret / events / disabledAt…）
  data      Json
  createdAt DateTime @map("created_at")

  @@index([tenantId])
  @@map("webhooks")
}

model ApiKeyRow {
  /// 完整金鑰字串（pk_/sk_）。MVP 沿用明文（與檔案 store 相同）；改存雜湊為後續事項
  key       String    @id
  tenantId  String    @map("tenant_id")
  type      String
  createdAt DateTime  @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  tenant    TenantRow @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model KnowledgeSourceRow {
  tenantId  String   @id @map("tenant_id")
  /// KnowledgeSource（startUrl / maxPages / chunkChars / embeddingModel / rerank…）
  source    Json     @default("{}")
  /// KnowledgeIndexMeta（status / chunkCount / files / suggestedPrompts…）
  meta      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_sources")
}

model KnowledgeIndexRow {
  tenantId    String   @id @map("tenant_id")
  generatedAt DateTime @map("generated_at")
  model       String
  source      String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("knowledge_indexes")
}

/// 註：knowledge_chunks 刻意不建 model——embedding 欄位為 pgvector 的 halfvec(3072)，
/// Prisma schema 無對應型別。該表的讀寫一律經 lib/db 的 $queryRaw / $executeRaw。

model ReportDocRow {
  reportId  String   @map("report_id")
  format    String
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  filename  String
  /// 報告產出物內容（Markdown / HTML bytes）
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@id([reportId, format])
  @@index([expiresAt])
  @@map("report_docs")
}
