{
  "name": "hyagent-server",
  "version": "1.2.0",
  "private": true,
  "description": "Agent-Native OA — 對話式表單填寫 Agent 後端（MVP：請假單，schema-driven，Claude + OA stub）",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "tsx scripts/engine-smoke.ts",
    "ingest:knowledge": "tsx scripts/knowledge-ingest.ts",
    "watch:knowledge": "tsx scripts/knowledge-watch.ts",
    "reconcile:knowledge": "tsx scripts/knowledge-reconcile.ts",
    "eval:knowledge": "tsx scripts/knowledge-eval.ts",
    "migrate:knowledge": "tsx scripts/knowledge-migrate-to-db.ts",
    "test": "jest",
    "db:smoke:write": "tsx scripts/db-smoke.ts write",
    "db:smoke:verify": "tsx scripts/db-smoke.ts verify",
    "eval:dbi": "tsx scripts/dbi-e2e-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.685.0",
    "@aws-sdk/s3-request-presigner": "^3.685.0",
    "@hyagent/shared": "*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@prisma/client": "^5.22.0",
    "@types/markdown-it": "^14.1.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.25.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "markdown-it": "^15.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "openai": "^6.41.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "playwright-core": "^1.64.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hyagent/db-intelligence": "*",
    "@hyagent/mcp-kit": "*",
    "@hyagent/store-demo": "*",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jszip": "^3.10.1",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
