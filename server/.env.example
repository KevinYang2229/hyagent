# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Store 持久化後端（file=記憶體+JSON 檔；db=記憶體+Postgres write-through）----
# db 涵蓋全部 8 個 runtime store（知識庫索引除外）。正式環境建議 db（容器檔案系統重佈即消失）。
DATA_BACKEND=file
# NODE_ENV=production 搭 DATA_BACKEND=file 時**必填 true**，否則 boot 直接失敗。
# file 模式的每一項機制（記憶體 Map 即 primary、`wx` 檔案鎖、開機重建索引）都假設只有一個副本；
# 跑兩個副本不會報錯，只會安靜地各自為政——A 副本撤銷的公鑰 B 副本照收，Session 也會時有時無。
# 確定是「單一副本 + 持久磁碟」才設；要擴副本請改 DATA_BACKEND=db。
# ALLOW_FILE_BACKEND_IN_PRODUCTION=true
# file 模式的 JSON 檔存放目錄。未設＝作業系統暫存目錄（os.tmpdir()，Windows 為 %TEMP%），
# 清暫存或重開機可能被清掉 → 租戶、API Key、Assertion 公鑰、對話一起消失。
# 要留得住就指到專案外的固定路徑（絕對路徑；Windows 用 C:/... 或 C:\...，別用 /c/... 這種 Git Bash 寫法）。
# 注意：這跟知識庫索引的 KNOWLEDGE_INDEX_DIR（預設 server/data/）是兩個不同的目錄，互不影響。
# OA_AGENT_DATA_DIR=D:/oa-agent-data
# DATA_BACKEND=db 時必填。Supabase：dashboard → Connect 取 session pooler 連線字串
# （transaction pooler 6543 埠需加 ?pgbouncer=true；migration 用 direct connection）
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Prisma 連線池上限；未設時 lib/db 套用保守預設。
# Supabase session pooler 全帳號共用 15 條，Prisma 原生預設會超過 → 建議明設。
# DB_CONNECTION_LIMIT=5
# 敏感欄位靜態加密（租戶 BYO LLM key、Session 上的使用者識別碼）：openssl rand -hex 32。
# 正式環境**必填**：未設時 HyAgent Session 會拒絕建立（使用者識別碼不得明文落地）。
# 未設＝明文落地（dev）；設定後新寫入即加密、舊明文開機自動補加密。正式環境建議必設，金鑰遺失即無法解密。
# DATA_ENCRYPTION_KEY=

# MCP（後端呼叫自建 MCP server）：呼叫身分 JWT 的 ES256 私鑰（PKCS#8 PEM，換行可寫成 \n）。
# 未設＝MCP 功能整體停用。產生方式：
#   node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('ec',{namedCurve:'P-256'});console.log(k.privateKey.export({type:'pkcs8',format:'pem'}).replace(/\n/g,'\\n'))"
# MCP_SIGNING_KEY=
# 換鑰過渡：上一把的公鑰（SPKI PEM），讓 MCP server 仍驗得過換鑰前簽的 token
# MCP_PREVIOUS_PUBLIC_KEY=

# 影像辨識查詢門市資料用的 MCP serverId（預設 store-demo）
# VISION_STORE_SERVER_ID=store-demo

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 帳密登入的共用密碼（default 租戶目錄內所有帳號共用一組）。
# NODE_ENV=production 且 AUTH_PASSWORD_LOGIN=on 時必須改掉，沿用此預設值會 boot fail-fast。
AUTH_DEV_PASSWORD=oa1234

# 帳密登入開關：
#   auto（預設）＝非 production 開、production 關（正式使用者走 SSO）
#   on           ＝明確開啟；production 也開，但必須自訂 AUTH_DEV_PASSWORD，
#                  且可登入的帳號以「該租戶後台設定的人員目錄」為準
#                  （內建的 kevin / hyweb 開發名錄在 production 一律不參與）
#                  token 綁呼叫端 API Key 解析到的租戶；此模式下這組密碼跨租戶共用
#   off          ＝一律關閉，連先前以帳密簽發的 token 也失效
# 宿主端 SSO 還沒接好、又需要先讓人登入使用時，才開 on。
AUTH_PASSWORD_LOGIN=auto

# CORS（第一方來源，如前端 SPA；逗號分隔多個，* 全放行）
CORS_ORIGIN=http://localhost:5173

# 多租戶：預設租戶（未帶 API Key 的舊 widget 落點）允許嵌入的網域
# * = 全放行（維持改造前行為，向後相容）；或逗號分隔網域收緊，如 https://a.com,https://b.com
DEFAULT_TENANT_ORIGINS=*

# 管理 API 主控密鑰（建立租戶 / 簽發金鑰 / 登記 webhook / 查用量）
# 留空 = 停用管理 API（預設關閉以策安全）；啟用請填一段夠長的隨機字串（如 openssl rand -hex 32）
# 呼叫時於 header 帶 x-admin-key: <此值>
ADMIN_API_KEY=

# 後台登入密碼；留空＝停用後台登入。建議 openssl rand -hex 24
ADMIN_PASSWORD=

# Redis（給 BullMQ / cache / rate-limit 共用）
REDIS_URL=redis://localhost:6379

# 登入保護：每個來源 IP、各端點獨立計數，預設視窗 15 分鐘。
# 目前為單程序記憶體計數；多副本部署需另接共用限流儲存或入口限流。
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_ADMIN_RATE_LIMIT_MAX=10
AUTH_SSO_RATE_LIMIT_MAX=60
AUTH_REFRESH_RATE_LIMIT_MAX=120
# 僅填實際可信代理 IP/CIDR（逗號分隔），預設不信任轉送標頭。
TRUST_PROXY=

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# S3 / 物件儲存（可指向 AWS S3、Cloudflare R2、MinIO）
S3_ENDPOINT=
S3_REGION=ap-northeast-1
S3_BUCKET=app-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# SMTP / Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="App <noreply@example.com>"

# 寄信連接器：stub=只寫 log 不真寄（預設）；smtp=真寄，此時 SMTP_HOST 必填（boot fail-fast）
EMAIL_CONNECTOR=stub

# ---- LLM provider（支援 anthropic / openai / local；預設 anthropic）----
# anthropic：claude-sonnet-4-5；openai：改 LLM_PROVIDER=openai、LLM_MODEL=gpt-4o-mini
# local：接地端自架的 OpenAI 相容端點（vLLM / Ollama / TGI），資料不出機房
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
# intent-router 意圖分類器用的便宜/快模型（省 token）；openai 時改為對應便宜模型如 gpt-4o-mini
LLM_ROUTER_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024
# provider=anthropic 必填
ANTHROPIC_API_KEY=
# provider=openai 必填；知識庫 RAG 的 embedding 也用 OpenAI（Claude 無原生 embedding），故啟用 RAG 時必填
OPENAI_API_KEY=
# 語音轉文字模型（App 語音對話用，需 OPENAI_API_KEY）
SPEECH_MODEL=gpt-4o-transcribe

# ---- 地端 LLM（LLM_PROVIDER=local 時生效）----
# 地端 chat 端點根路徑（含 /v1）；設 local 時必填，否則 boot fail-fast
# LLM_BASE_URL=http://vllm:8000/v1
# 地端通常不驗 key；留預設即可（OpenAI SDK 不接受空字串）
LLM_API_KEY=not-needed
# 地端範例：LLM_PROVIDER=local / LLM_MODEL=Qwen2.5-32B-Instruct / LLM_ROUTER_MODEL=Qwen2.5-7B-Instruct / LLM_BASE_URL=http://vllm:8000/v1
# 地端時 LLM_ROUTER_MODEL 也須改為地端模型名（預設是 claude-haiku，地端端點無此模型會 404）

# ---- Embedding 供應商（openai=雲端；local=地端 /v1/embeddings）----
EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=local 時必填；換模型後各租戶索引需以同模型重跑 ingest
# EMBEDDING_BASE_URL=http://vllm:8000/v1

# ---- 知識庫 RAG（每租戶靜態網站索引；可在 admin 後台逐租戶設定/觸發）----
# embedding 需 OPENAI_API_KEY（見上）。以下為「未設定時的預設值」，admin UI 的租戶設定會覆蓋。
# 精準度優先預設 large；要省成本改 text-embedding-3-small（改後需以相同模型重跑該租戶 ingest）
EMBEDDING_MODEL=text-embedding-3-large
# 每租戶索引檔存放目錄；檔名為 knowledge-index.<tenantId>.json
KNOWLEDGE_INDEX_DIR=data
# 兩階段檢索：向量取候選池後用 LLM_ROUTER_MODEL 重排（精準度↑，每次知識查詢多一次便宜呼叫）；設 false 關閉
KNOWLEDGE_RERANK=true

# ---- 報告（依知識庫檢索彙整成可下載文件；需 service:report scope）----
# 大綱節數上限（1–12）。每節各一次檢索＋一次彙整 LLM，節數直接決定一份報告的成本
REPORT_MAX_SECTIONS=6
# 每節交給彙整 LLM 的檢索片段數（1–20）
REPORT_SECTION_TOP_K=5
# 產出物保存時數（1–8760）；預設 720＝30 天。過短會讓後台報告查詢頁沒東西可查
REPORT_TTL_HOURS=720
# 報告表頭產生時間的顯示時區（IANA 名）。正式環境跑 UTC，不設會把台北 09:41 印成 01:41
REPORT_TIMEZONE=Asia/Taipei
# 印 PDF 用的 Chromium 執行檔；未設時自動探測（容器 /usr/bin/chromium、本機 Chrome）。
# 探測不到只是少一種下載格式，md / html 照常產出
# REPORT_PDF_BROWSER=/usr/bin/chromium

# ---- OA 連接器（stub=不接真 OA；http=接真 OA 系統）----
# stub：送出回合成單號 STUB-xxxxxxxx，零外部依賴即可跑完整條 chat→submit（dev 預設）。
# http：真送單。端點與欄位映射由各表單的 schemas/<formId>/oa.schema.json 驅動，
#       不必改 server/src/lib/oa/http.connector.ts。詳見 docs/HANDOFF-OA-HTTP.md。
OA_CONNECTOR=stub
# OA_CONNECTOR=http 時必填（boot fail-fast）。結尾斜線會被去掉，oa.schema 的 endpoint 直接接在後面
# OA_BASE_URL=https://oa.example.com
# 有設就以 Authorization: Bearer <值> 送出；留空＝不帶認證標頭
# OA_API_KEY=

# 本機開發：用 mock OA server 代替真 OA（不必等真系統開通）
#   node presale/oa-mock/server.mjs          # 另開終端機，預設 http://localhost:4100
#   OA_CONNECTOR=http OA_BASE_URL=http://localhost:4100 npm run dev -w server
