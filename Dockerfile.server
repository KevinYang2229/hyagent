# HyAgent server；build context 為 repo 根目錄，需要 BuildKit 的 npm 快取掛載。
# 使用 Docker Hub 的 Google 快取，降低共用出口 IP 遇到限流的機會。
FROM mirror.gcr.io/library/node:20-slim AS manifests
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY shared/package.json ./shared/
# server 的開發依賴含這兩個本地 workspace，npm 解析時需要 manifest。
COPY mcp/kit/package.json ./mcp/kit/
COPY mcp/store-demo/package.json ./mcp/store-demo/

FROM manifests AS build-deps
# 不在安裝時重複產生 Prisma client；下個獨立快取層會依 schema 明確產生。
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
  PRISMA_SKIP_POSTINSTALL_GENERATE=true npm ci --include=dev \
    --workspace=server --include-workspace-root=false --no-audit --no-fund

FROM build-deps AS build
# schema 未變時可重用 Prisma client，不因一般 TS／前端／文件修改而重新產生。
COPY server/prisma ./server/prisma
RUN npm run db:generate -w server
COPY server/tsconfig.json server/tsconfig.build.json ./server/
COPY shared/src ./shared/src
COPY server/src ./server/src
RUN npm exec --workspace=server -- tsc -p tsconfig.build.json \
  && npm exec --workspace=server -- tsc-alias -p tsconfig.build.json

FROM manifests AS production-deps
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
  PRISMA_SKIP_POSTINSTALL_GENERATE=true npm ci --omit=dev \
    --workspace=server --include-workspace-root=false --no-audit --no-fund

FROM mirror.gcr.io/library/node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Chromium 同時用於報告 PDF 與動態網站解析；CJK 字型支援中文 PDF。
# 系統套件層獨立於 npm 與原始碼，變更程式時可沿用快取。
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl chromium fonts-noto-cjk \
  && rm -rf /var/lib/apt/lists/*
ENV REPORT_PDF_BROWSER=/usr/bin/chromium
ENV KNOWLEDGE_BROWSER_EXECUTABLE=/usr/bin/chromium
ENV PORT=3000

COPY --from=production-deps /app/package.json /app/package-lock.json ./
COPY --from=production-deps /app/node_modules ./node_modules
# 保留 workspace 層級的巢狀 production 依賴與 package.json。
COPY --from=production-deps /app/server ./server
COPY --from=production-deps /app/shared ./shared
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY schemas ./schemas

EXPOSE 3000
CMD ["node", "server/dist/index.js"]
